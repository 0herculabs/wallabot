# Copia este fichero a .env y ajusta los valores.

# Clave para firmar la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Ruta al fichero SQLite.
DB_PATH=wallabot.db

# Host/puerto de uvicorn.
HOST=0.0.0.0
PORT=12185

# Coordenadas por defecto para las búsquedas (la API de Wallapop devuelve
# resultados vacíos sin lat/lon). Ejemplo: Madrid.
DEFAULT_LATITUDE=40.4168
DEFAULT_LONGITUDE=-3.7038

# Zona horaria para mostrar fechas en la web y para la hora del backup diario
# (nombre de la base de datos IANA, gestiona bien el cambio de horario).
TIMEZONE=Europe/Madrid

# --- Notificaciones por email (opcional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Solo para docker-compose: crea este usuario administrador automáticamente
# en el primer arranque (si ya existe, no hace nada). Cambia la contraseña en
# cuanto inicies sesión (Cuenta -> Cambiar contraseña). ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wallabot
# ADMIN_EMAIL=

# --- Notificaciones por Telegram (opcional) ---
# Token del bot, obtenido al crearlo con @BotFather en Telegram.
# TELEGRAM_BOT_TOKEN=

# URL pública/local por la que accedes a Wallabot (sin barra final). Se usa
# para construir enlaces "ver todos los resultados" dentro de los emails.
# Si no la defines, el email simplemente omite ese botón.
# PUBLIC_BASE_URL=http://192.168.1.100:12185
